{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "backup": "bash scripts/backup_to_server.sh",
    "lint": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "resguardo:exportar": "node scripts/resguardo.mjs exportar",
    "resguardo:verificar": "node scripts/resguardo.mjs verificar",
    "resguardo:comparar": "node scripts/resguardo.mjs comparar",
    "test:resguardo": "cd scripts/rules-test && npx firebase emulators:exec --only firestore --config ../resguardo-ensayo/firebase.json --project demo-resguardo \"bash ../resguardo-ensayo/ensayo.sh\"",
    "test:resguardo-nube": "cd scripts/rules-test && npx firebase emulators:exec --only firestore,storage --config ../resguardo-ensayo/firebase-nube.json --project demo-resguardo \"bash ../resguardo-ensayo/ensayo-nube.sh\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
